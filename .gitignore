# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets
.env
.env.local

# Runtime data (sessions are credentials)
data/
storageState.json

# Scraped user data (per-account; never commit)
scraped/

# Personal assistant config (name, matrícula, per-item overrides) — any path
**/profile.json
**/overrides.json

# Runtime outputs that may contain personal data — any path
**/answers.json
**/submissions.json
**/storageState.json

# Playwright artifacts (screenshots, snapshots, traces)
.playwright-mcp/
playwright-report/
test-results/
blob-report/
playwright/.cache/
playwright/.auth/

# Logs
*.log
logs/

# OS
.DS_Store
