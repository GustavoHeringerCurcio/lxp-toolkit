# Pauta (LXP ToolKit) environment
OPENAI_API_KEY=sk-...
# Where the scraped LXP data lives (defaults to ../../scraped, the repo-root study data)
DATA_DIR=../../scraped
PORT=4174
# Postgres connection string (required). `docker compose up -d` provides this default.
DATABASE_URL=postgres://lxp:lxp@localhost:5433/lxp
