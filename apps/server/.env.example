# LXP Toolkit backend — copy to apps/server/.env (gitignored).
# Only needed for AI generation; scraping works without it.
OPENAI_API_KEY=sk-...

# Where the scraped LXP data lives (defaults to ../../scraped, the repo-root study data)
DATA_DIR=../../scraped
PORT=4174

# Postgres connection string (required). `npm run db:up` provides this default.
DATABASE_URL=postgres://lxp:lxp@localhost:5433/lxp

# Optional: path to the LibreOffice `soffice` binary, if it isn't on PATH.
# Needed for `.pdf` delivery and Office previews.
# SOFFICE_BIN=/usr/bin/soffice
