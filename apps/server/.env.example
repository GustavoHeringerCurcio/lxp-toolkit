# LXP Toolkit backend — copy to apps/server/.env (gitignored).
# Only needed for AI generation; scraping works without it.
OPENAI_API_KEY=sk-...

# Where the scraped LXP data lives (defaults to ../../scraped, the repo-root study data)
DATA_DIR=../../scraped
PORT=4174

# Postgres connection string (required). `npm run db:up` provides this default.
DATABASE_URL=postgres://lxp:lxp@localhost:5434/lxp

# Daily automatic refresh (optional; Docker Compose turns it on by default).
# For host runs (`npm run dev` / `npm run web`) set AUTO_REFRESH=1 to enable.
# Docker Compose reads overrides from a root .env next to docker-compose.yml;
# this file is for host runs. The first start of the day is the boot catch-up;
# REFRESH_AT is the fallback when the machine stays on. Use a comma-separated
# list for multiple runs/day. Empty quiet values disable the quiet window.
# AUTO_REFRESH=1
# REFRESH_AT=11:00
# REFRESH_TZ=America/Sao_Paulo
# REFRESH_BOOT_DELAY_SECONDS=120
# REFRESH_QUIET_START=22:00
# REFRESH_QUIET_END=10:30
# REFRESH_RETRY_MINUTES=60
# REFRESH_MAX_ATTEMPTS=3
# REFRESH_HEADFUL_RETRY=0
# Optional: override the JSON refresh log directory.
# REFRESH_LOG_DIR=

# Optional: path to the LibreOffice `soffice` binary, if it isn't on PATH.
# Needed for `.pdf` delivery and Office previews.
# SOFFICE_BIN=/usr/bin/soffice
