{
  "name": "lxp-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LXP homework assistant — ordered exercise views + transparent AI answer generation over the scraped LXP data.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assistant": "tsx cli/main.ts",
    "index": "tsx src/load.ts",
    "web": "npm run build:web && tsx server/server.ts",
    "web:dev": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
