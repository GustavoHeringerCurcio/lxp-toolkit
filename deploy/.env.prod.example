# Compose variable substitution — copy to deploy/.env.prod (gitignored) and edit.
#
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# This file only feeds ${...} values in docker-compose.prod.yml. The real
# runtime secrets (LXP login, OPENAI_API_KEY, DATABASE_URL, TOOLKIT_TOKEN) live
# in apps/server/.env and packages/portal/.env on the VM.

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=change-me

# Shared secret between the Vercel proxy and the backend. Generate with:
#   openssl rand -hex 32
TOOLKIT_TOKEN=change-me
