{
  "name": "webscraping-unifoa-lycum-",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scrape and reverse-engineer the Grupoa LXP platform (unifoa2.grupoa.education) — map routes, capture the API, dump all course content to markdown, and drive an exercise-completion agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "login": "tsx scripts/login.ts",
    "dump": "tsx scripts/dump-content.ts",
    "dump-surfaces": "tsx scripts/dump-surfaces.ts",
    "capture-api": "tsx scripts/capture-api.ts",
    "crawl-routes": "tsx scripts/crawl-routes.ts",
    "submit-task": "tsx scripts/submit-task.ts",
    "agent": "tsx scripts/agent.ts",
    "exercises": "tsx scripts/exercises.ts",
    "homework": "tsx scripts/homework.ts",
    "index": "tsx scripts/build-homework-index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "node-html-markdown": "1.3.0",
    "pino": "10.3.1",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pino": "7.0.4",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
