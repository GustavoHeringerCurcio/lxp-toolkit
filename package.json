{
  "name": "lxp-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UniFOA / Grupoa LXP study toolkit — a reverse-engineering scraper (packages/portal) and the LXP Toolkit web app (apps/web + apps/server).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node setup/index.mjs",
    "doctor": "node setup/doctor.mjs",
    "login": "npm run login -w @lxp-toolkit/portal",
    "dump": "npm run dump -w @lxp-toolkit/portal",
    "dump-surfaces": "npm run dump-surfaces -w @lxp-toolkit/portal",
    "capture-api": "npm run capture-api -w @lxp-toolkit/portal",
    "crawl-routes": "npm run crawl-routes -w @lxp-toolkit/portal",
    "submit-task": "npm run submit-task -w @lxp-toolkit/portal",
    "agent": "npm run agent -w @lxp-toolkit/portal",
    "exercises": "npm run exercises -w @lxp-toolkit/portal",
    "homework": "npm run homework -w @lxp-toolkit/portal",
    "index": "npm run index -w @lxp-toolkit/portal",
    "index:web": "npm run index -w @lxp-toolkit/server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @lxp-toolkit/server",
    "db:import": "npm run db:import -w @lxp-toolkit/server",
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:fresh": "node scripts/dev.mjs --sync",
    "preweb": "node scripts/sync.mjs",
    "web": "npm run web -w @lxp-toolkit/server",
    "web:dev": "npm run dev -w @lxp-toolkit/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
