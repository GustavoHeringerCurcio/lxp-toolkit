# ---------------------------------------------------------------------------
# Grupoa LXP scraper — environment
# ---------------------------------------------------------------------------

# --- Lyceum SSO (used ONLY to authenticate and reach the LXP; never scraped) ---
LXP_LOGIN_URL=https://unifoa.lyceum.com.br/aluno/#/login
LXP_USERNAME=
LXP_PASSWORD=

# --- LXP platform ---
LXP_URL=https://unifoa2.grupoa.education/plataforma/
API_BASE=https://api.plataforma.grupoa.education

# --- General ---
TZ=America/Sao_Paulo
LOG_LEVEL=info
PLAYWRIGHT_NO_SANDBOX=false
HEADFUL=false

# --- Output ---
# Where YOUR scraped data / raw captures are written (local only, gitignored).
# Each user scrapes their own account here — do not commit it.
OUT_DIR=scraped
