{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @lxp-toolkit/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/proxy/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy/api/:path*" },
    { "source": "/scraped/:path*", "destination": "/api/proxy/scraped/:path*" }
  ]
}
